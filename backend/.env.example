PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/pago_movil"

# Contraseña que usan las cajeras para entrar a la web app
APP_PASSWORD=

# Credenciales OAuth2 de Google Cloud Console (proyecto con Gmail API habilitada)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Correo/remitente exacto del banco (para filtrar solo esos correos)
BANK_SENDER_EMAIL=conexionmipago@bancaribe.com.ve

# Expresión cron para la frecuencia de revisión de correos (por defecto cada 2 min)
POLL_INTERVAL_CRON="*/2 * * * *"

# Clave que usa el Android (MacroDroid) para enviar las notificaciones de Banesco
INGEST_TOKEN=

# Verificación por Telegram de pagos que no llegaron (opcional)
# Token del bot creado con @BotFather, y el/los ID de chat autorizados separados por coma
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Consulta de pagos móviles en el API de Mercantil (opcional).
# Datos que entrega Mercantil: Client ID del portal, clave secreta de cifrado y códigos de comercio.
MERCANTIL_CLIENT_ID=
MERCANTIL_SECRET_KEY=
MERCANTIL_MERCHANT_ID=
MERCANTIL_INTEGRATOR_ID=1
MERCANTIL_TERMINAL_ID=1
# Teléfono de la cuenta jurídica que recibe los pagos, ej. 04141234567
MERCANTIL_TELEFONO=
# certificacion (pruebas) o produccion
MERCANTIL_AMBIENTE=certificacion
