generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoConciliacion {
  PENDIENTE
  VERIFICADO
  SIN_MATCH
  AMBIGUO
  ANULADO
}

model PagoRecibido {
  id             String   @id @default(cuid())
  gmailMessageId String?  @unique
  banco          String
  monto          Decimal
  referencia     String?
  telefonoPagador   String?
  telefonoReceptor  String?
  fechaPago      DateTime
  fechaCorreo    DateTime
  rawSnippet     String?
  cobradoAt      DateTime?
  cobradoPor     String?
  verificadoPor  String?
  createdAt      DateTime @default(now())

  conciliacion   Conciliacion?

  @@unique([banco, referencia])
}

model PedidoPendiente {
  id             String   @id @default(cuid())
  descripcion    String
  montoEsperado  Decimal
  clienteNombre  String?
  clienteTelefono String?
  estado         String   @default("PENDIENTE")
  createdAt      DateTime @default(now())

  conciliacion   Conciliacion?
}

model Conciliacion {
  id           String             @id @default(cuid())
  pagoId       String             @unique
  pago         PagoRecibido       @relation(fields: [pagoId], references: [id])
  pedidoId     String?            @unique
  pedido       PedidoPendiente?   @relation(fields: [pedidoId], references: [id])
  estado       EstadoConciliacion @default(PENDIENTE)
  metodoMatch  String?
  revisadoPor  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum EstadoVerificacion {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
}

// Pago que la web no encontró y la cajera pidió verificar por Telegram.
model SolicitudVerificacion {
  id               String             @id @default(cuid())
  banco            String
  referencia       String
  monto            Decimal
  solicitadoPor    String
  estado           EstadoVerificacion @default(PENDIENTE)
  resueltoPor      String?
  resueltoAt       DateTime?
  telegramMensajes String?
  pagoId           String?
  createdAt        DateTime           @default(now())
}
